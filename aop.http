### Отримання JWT-токена з Keycloak
POST http://localhost:8081/realms/java-lab-realm/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=spring-client&client_secret=0xnFYAjdvuwrBGYSloUZrqaToGdOeWRccYpPdw4y5LKPimUCs4rGyQmrF96lqsQ0zPlbPnRJbM8m1dPogeHUJL&username=user2&password=1212

> {%
    client.test("Token received", function () {
        client.assert(response.status === 200, "Keycloak error: " + JSON.stringify(response.body));
        client.assert(response.body.access_token !== undefined, "No access_token in response");
    });
    if (response.body && response.body.access_token) {
        client.global.set("auth_token", response.body.access_token);
    }
%}

### Перший запит на створення замовлення з ключем ідемпотентності
POST http://localhost:8080/api/orders
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Idempotency-Key: demo-idem-key-101

{
  "customerTag": "Idempotent_Player",
  "virtualAssetId": 3,
  "quantity": 1
}

### Повторний запит з тим самим Idempotency-Key
POST http://localhost:8080/api/orders
Authorization: Bearer {{auth_token}}
Content-Type: application/json
Idempotency-Key: demo-idem-key-101

{
  "customerTag": "Idempotent_Player",
  "virtualAssetId": 3,
  "quantity": 1
}
